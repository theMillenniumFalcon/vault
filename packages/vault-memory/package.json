{
  "name": "vault-memory",
  "version": "0.1.0",
  "description": "Agent-attributed memory layer for AI agents — single-agent now, multi-agent conflict resolution in the roadmap.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "verify:consumer": "bun run build && node scripts/verify-consumer.mjs"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.44.0"
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "bun-types": "^1.2.22",
    "drizzle-orm": "^0.44.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
