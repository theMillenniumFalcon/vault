{
  "name": "vault-memory",
  "version": "0.1.0",
  "description": "Agent-attributed memory layer for AI agents — single-agent now, multi-agent conflict resolution in the roadmap.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "import": "./dist/pg.js",
      "require": "./dist/pg.cjs"
    },
    "./faiss": {
      "types": "./dist/faiss.d.ts",
      "import": "./dist/faiss.js",
      "require": "./dist/faiss.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theMillenniumFalcon/vault.git",
    "directory": "packages/vault-memory"
  },
  "keywords": [
    "ai",
    "agents",
    "memory",
    "llm",
    "drizzle",
    "embeddings",
    "rag"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "verify:consumer": "bun run build && node scripts/verify-consumer.mjs",
    "publish:public": "npm publish --access public"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.44.0",
    "faiss-node": "^0.5.0"
  },
  "peerDependenciesMeta": {
    "faiss-node": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "bun-types": "^1.2.22",
    "drizzle-orm": "^0.44.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
