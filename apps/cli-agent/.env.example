# Required — OpenAI API key for fact extraction, classification, and embeddings.
OPENAI_API_KEY=sk-your-key-here

# Shared SQLite file used by all agents in the multi-agent demo.
# Both `start:agent-a` and `start:agent-b` default to this path.
VAULT_DB_PATH=./vault-shared.db

# Conversation id stored on new claims (optional).
VAULT_CONVERSATION_ID=cli-session

# Only used by `bun run start` (generic entry). Ignored by agent-a / agent-b scripts.
# AGENT_ID=agent-a
